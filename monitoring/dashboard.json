  {
   "type": "timeseries",
   "title": "Request rate \u00b7 by route",
   "description": "Requests per second handled by the backend. X axis: time.",
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (route, status) (rate(backend_requests_total[1m]))",
     "legendFormat": "{{route}} {{status}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "axisLabel": "Requests/s (linear)",
      "lineWidth": 2,
      "scaleDistribution": {
       "type": "linear",
       "log": 10
      },
      "showPoints": "always",
      "pointSize": 4
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byFrameRefID",
       "options": "A"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#0072B2"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "bottom",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi"
    }
   },
